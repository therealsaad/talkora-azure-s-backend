{
  "name": "talkora-backend",
  "version": "1.0.0",
  "packageManager": "pnpm@10.18.0",
  "description": "Talkora backend engine — auth, curriculum, progress, AI (Miss Julie) and voice service boundaries",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/seed/seed.ts",
    "migrate:student-avatars": "tsx src/scripts/migrate-student-avatar-type.ts",
    "migrate:curriculum-v1": "tsx src/scripts/migrate-curriculum-v1.ts",
    "db:ensure-indexes": "tsx src/scripts/ensure-indexes.ts",
    "migrate:unit1-syllabus": "tsx src/scripts/migrate-unit1-pedagogy-v4.ts",
    "migrate:unit1-pedagogy": "tsx src/scripts/migrate-unit1-pedagogy-v4.ts",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1142.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.5.0",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.15",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.2.4",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
